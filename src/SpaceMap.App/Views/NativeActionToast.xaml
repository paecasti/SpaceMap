<UserControl x:Class="SpaceMap.App.Views.NativeActionToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            CornerRadius="14"
            Background="#E1F5E3"
            BorderBrush="#6CA56F"
            BorderThickness="1"
            Visibility="{Binding NativeActionToast.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="{Binding NativeActionToast.Message}" TextWrapping="Wrap" />
    </Border>
</UserControl>
