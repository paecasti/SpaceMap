<UserControl x:Class="SpaceMap.App.Views.CloseScanConfirmationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            Background="#FDE7E4"
            BorderBrush="#D68A7D"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="{Binding ScanWorkspace.HasActiveScan, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock Text="Closing with an active scan will ask for confirmation and preserve only confirmed results." TextWrapping="Wrap" />
    </Border>
</UserControl>
