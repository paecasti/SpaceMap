<UserControl x:Class="SpaceMap.App.Views.OmittedItemsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="Omisiones detectadas" IsExpanded="True">
        <ListBox ItemsSource="{Binding OmittedItems.Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding FullPath}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReasonCode}" />
                        <TextBlock Foreground="#6A6A6A" Text="{Binding ReasonDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Expander>
</UserControl>
