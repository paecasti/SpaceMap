<UserControl x:Class="SpaceMap.App.Views.ScanProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12" CornerRadius="14" Background="#E5EFE8" BorderBrush="#C5D6CA" BorderThickness="1">
        <DockPanel>
            <TextBlock FontWeight="SemiBold" Text="{Binding ScanWorkspace.StatusText, StringFormat='Status: {0}'}" />
            <TextBlock Margin="12,0,0,0" Text="{Binding ScanWorkspace.EntriesProcessed, StringFormat='Processed: {0:N0}'}" />
            <TextBlock Margin="12,0,0,0" Text="{Binding Navigation.CurrentPath, StringFormat='Current path: {0}'}" />
        </DockPanel>
    </Border>
</UserControl>
